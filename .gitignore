# Entorno virtual y cache de Python
.venv/
venv/
__pycache__/
*.py[cod]

# Credenciales: se ignora cualquier variante de .env salvo la plantilla,
# porque los respaldos (.env.bak, .env.sqlite.bak) tambien llevan la clave.
.env
.env.*
!.env.example

# Base de datos local y archivos subidos
instance/
*.db
*.sqlite3

# Registros de ejecucion
*.log

# Sistema operativo y editores
.DS_Store
.idea/
.vscode/

# Big Data: el data lake pesa cientos de MB y se regenera con bigdata/pipeline.py
bigdata/datalake/

# Archivos de trabajo del documento y de las capturas de evidencia
.venv-capturas/
herramientas_capturas/
Documento/
Checklist_SGDS_Evaluado.xlsx
_sca_tmp.txt
