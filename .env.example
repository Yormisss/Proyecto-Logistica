# Copie este archivo como .env y ajuste los valores.

# Clave de firma de sesiones (RNF5). Genere una nueva para produccion:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Obligatoria si ENTORNO=produccion: la aplicacion no arranca sin ella.
SECRET_KEY=cambie-esta-clave

# Entorno: desarrollo | produccion | pruebas
ENTORNO=desarrollo

# Base de datos.
# Desarrollo (por defecto): SQLite local, no requiere configuracion.
# Produccion / piloto (RNF4): MySQL
# Obligatoria si ENTORNO=produccion: la aplicacion no arranca sin ella.
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3307/logistica

# RF3 - Proveedor de geolocalizacion: OSRM | MAPBOX | GOOGLE
PROVEEDOR_MAPAS=OSRM
MAPAS_API_KEY=

# Origen de las rutas: centro de distribucion
CD_NOMBRE=Centro de Distribucion Bogota
CD_LAT=4.6482837
CD_LNG=-74.2478938

PORT=5001

# Asistente de voz del conductor (Retell AI). Opcional: sin estas dos variables
# el boton del asistente no aparece y la aplicacion funciona igual.
# Use la API key que tiene el distintivo de webhook en el panel de Retell:
# tambien verifica la firma de las custom functions.
# RETELL_API_KEY=
# RETELL_AGENTE_CONDUCTOR_ID=

# Automatizaciones con Make. Todas opcionales.
# Webhook que recibe los avisos (estado del pedido al cliente y stock bajo).
# MAKE_WEBHOOK_URL=https://hook.us1.make.com/...
# API key del webhook (Make > Webhooks > API key). Se envia en x-make-apikey.
# MAKE_WEBHOOK_KEY=
# Correo del equipo de operaciones: destino de los avisos internos de stock
# bajo y del resumen diario. Vacio = no se envian avisos internos.
# CORREO_OPERACIONES=operaciones@empresa.com
# Token con el que Make consulta GET /api/automatizacion/resumen-diario
# (encabezado X-Automatizacion-Token). Vacio = el endpoint responde 404.
# Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOMATIZACION_TOKEN=

# Solo para la demo: seed.py asigna este correo a "Supermercado El Portal" para
# que el escenario de Make tenga a quien escribir sin pasos manuales.
# SEMILLA_CORREO_CLIENTE=
