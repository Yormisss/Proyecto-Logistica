# Copie este archivo como .env y ajuste los valores.

# Clave de firma de sesiones (RNF5). Genere una nueva para produccion:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Obligatoria si ENTORNO=produccion: la aplicacion no arranca sin ella.
SECRET_KEY=cambie-esta-clave

# Clave del cifrado del documento y el telefono de las cuentas (RNF5).
# OBLIGATORIA: defina una propia antes de crear o migrar la base. Si ENTORNO=
# produccion la aplicacion no arranca sin ella; en desarrollo, si falta, se
# deriva de SECRET_KEY y cambiar SECRET_KEY tendria el mismo efecto.
# NO LA CAMBIE NI LA PIERDA una vez cifrados los datos: con otra clave los
# documentos y telefonos ya guardados no se pueden leer (no hay recuperacion).
# Guarde una copia segura fuera del repositorio.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAVE_CIFRADO=cambie-esta-clave-de-cifrado

# Entorno: desarrollo | produccion | pruebas
ENTORNO=desarrollo

# Base de datos.
# Desarrollo (por defecto): SQLite local, no requiere configuracion.
# Produccion / piloto (RNF4): MySQL
# Obligatoria si ENTORNO=produccion: la aplicacion no arranca sin ella.
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3307/logistica

# RF3 - Proveedor de geolocalizacion: OSRM | MAPBOX | GOOGLE
PROVEEDOR_MAPAS=OSRM
MAPAS_API_KEY=

# Origen de las rutas: centro de distribucion
CD_NOMBRE=Centro de Distribucion Bogota
CD_LAT=4.6482837
CD_LNG=-74.2478938

PORT=5001

# Asistente de voz (Retell AI). Opcional: sin la API key, o sin el agente de un
# rol, el boton del asistente no aparece para ese rol y la aplicacion funciona
# igual. Use la API key que tiene el distintivo de webhook en el panel de
# Retell: tambien verifica la firma de las custom functions.
# RETELL_API_KEY=
# RETELL_AGENTE_CONDUCTOR_ID=
# RETELL_AGENTE_GESTOR_ID=
# RETELL_AGENTE_ADMIN_ID=
# RETELL_AGENTE_CLIENTE_ID=
# Para `flask --app run sincronizar-asistentes`, que crea o actualiza los
# agentes por API: la URL https publica del servidor (ngrok o Render) y la voz
# en espanol con la que se crean los agentes nuevos (panel de Retell, Voices).
# URL_PUBLICA=https://xxxx.ngrok-free.app
# RETELL_VOZ_ID=

# Automatizaciones con Make. Todas opcionales. Son dos escenarios, cada uno con
# su webhook; la app solo ENVIA (Make nunca la llama). Iguales en el PC y en el
# servidor: solo cambian estas variables.
#
# Escenario "SGDS" (avisos de la operacion): estado del pedido al cliente,
# stock bajo, solicitudes de contacto, acciones del asistente y ruta asignada.
# MAKE_WEBHOOK_URL=https://hook.us1.make.com/<webhook de SGDS>
# API key de los webhooks (Make > Webhooks > API key), la misma en los dos
# escenarios. Se envia en el encabezado x-make-apikey.
# MAKE_WEBHOOK_KEY=
#
# Escenario "Rutalytics Privado" (con "Data is confidential"): las TRES
# variables siguientes llevan la MISMA URL, la de su webhook, y el escenario
# enruta por el campo "tipo".
# - credencial_usuario: la contrasena de una cuenta creada o restablecida por
#   voz. Vacio = no se crean ni restablecen cuentas por voz (en pantalla si).
# MAKE_WEBHOOK_CREDENCIALES_URL=https://hook.us1.make.com/<webhook de Rutalytics Privado>
# - restablecimiento_contrasena: el enlace de "Olvide mi contrasena", que se
#   arma con URL_PUBLICA (obligatoria para este envio). Vacio = en produccion
#   no se ofrece la recuperacion; en desarrollo el enlace sale en la consola.
# MAKE_WEBHOOK_RESTABLECIMIENTO_URL=https://hook.us1.make.com/<webhook de Rutalytics Privado>
# - resumen_diario: el resumen del dia, que se envia desde el tablero, por voz
#   o con "flask --app run enviar-resumen" programado. Vacio = no se envia.
# MAKE_WEBHOOK_RESUMEN_URL=https://hook.us1.make.com/<webhook de Rutalytics Privado>
#
# Los avisos llegan al correo de avisos de cada cuenta segun su rol (o, si no
# tiene uno, a su correo de inicio de sesion): stock bajo y solicitudes a los
# gestores, el resumen a gestores y administradores, las acciones del
# asistente a los administradores y la ruta asignada a su conductor.
# CORREO_OPERACIONES es solo el RESPALDO: recibe un aviso interno cuando no hay
# ninguna cuenta activa del rol con correo. Vacio = en ese caso no sale.
# CORREO_OPERACIONES=operaciones@empresa.com
# Token de los endpoints de respaldo GET /api/automatizacion/resumen-diario y
# /api/automatizacion/auditoria (encabezado X-Automatizacion-Token). Ya no los
# necesita ningun escenario. Vacio = los endpoints responden 404.
# Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOMATIZACION_TOKEN=

# Solo para la demo: seed.py asigna este correo a "Supermercado El Portal" para
# que el escenario de Make tenga a quien escribir sin pasos manuales.
# SEMILLA_CORREO_CLIENTE=
# Correo de avisos de las cuentas demo (seed.py), para recibir sus avisos en
# correos reales: admin@sgds.com, despachador@sgds.com y conductor1@sgds.com.
# Vacias = sus avisos van a su correo de inicio de sesion (@sgds.com, que no
# existe). Ponga aqui sus correos, nunca en el codigo. La siembra no envia
# avisos a Make aunque MAKE_WEBHOOK_URL este definido.
# SEMILLA_CORREO_ADMIN=
# SEMILLA_CORREO_GESTOR=
# SEMILLA_CORREO_CONDUCTOR=
